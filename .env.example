# ⚠️ THIS IS A TEMPLATE FILE
# Copy this to .env and fill in with your actual values
# NEVER commit the .env file to Git!

# ======================================
# Backend Configuration
# ======================================

# Node environment
NODE_ENV=development

# Server port
PORT=5001

# MongoDB URI
# Local development:
MONGODB_URI=mongodb://localhost:27017/hydrogrid
# Or use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/hydrogrid

# JWT Secret Key (generate a strong random string)
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# JWT Expiration (in days)
JWT_EXPIRE=7

# Email Configuration (Optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# ======================================
# Frontend Configuration
# ======================================

# API Base URL
VITE_API_URL=http://localhost:5001/api

# Frontend URL (for CORS)
VITE_FRONTEND_URL=http://localhost:5173

# ======================================
# Production Configuration
# ======================================

# When deploying to production, use:
# NODE_ENV=production
# MONGODB_URI=mongodb+srv://prod-user:prod-password@prod-cluster.mongodb.net/hydrogrid
# JWT_SECRET=your_production_secret_key_must_be_strong
# PORT=80 (or your cloud platform's port)

# ======================================
# Optional: External Services
# ======================================

# Google OAuth (Optional)
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# SendGrid (Optional)
# SENDGRID_API_KEY=your_sendgrid_api_key

# Analytics (Optional)
# SEGMENT_WRITE_KEY=your_segment_key

# ======================================
# Database Seeding
# ======================================

# Set to true to seed database with demo data on startup
SEED_DATABASE=false

# ======================================
# Logging
# ======================================

# Log level: error, warn, info, debug, trace
LOG_LEVEL=debug

# ======================================
# Security
# ======================================

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting (requests per 15 minutes)
RATE_LIMIT=100

# ======================================
# Developer Tools
# ======================================

# Enable detailed error messages (disable in production!)
DEBUG=false

# Enable API request/response logging
LOG_REQUESTS=true
