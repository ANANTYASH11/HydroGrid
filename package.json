    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "seed": "cd server && npm run seed",
    "docker": "docker-compose up -d",
    "docker-down": "docker-compose down"
  },
  "keywords": [
    "water",
    "electricity",
    "analytics",
    "IoT",
    "smart-home",
    "sustainability"
  ],
  "author": "HydroGrid Team",
