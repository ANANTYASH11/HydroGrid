# Supabase PostgreSQL Connection
DATABASE_URL=postgresql://user:password@host:port/database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# JWT Secret Key - change this to a random string in production
JWT_SECRET=your-super-secret-jwt-key-here-change-in-production

# Server Port
PORT=5000

# SMTP Configuration for Email Delivery
# ========================================

# Option 1: Using Gmail API (BEST FOR RENDER - Recommended)
# Works on Render without firewall blocking
# See: GMAIL_API_SETUP.md for detailed instructions
# Get service account JSON from: https://console.cloud.google.com
# GMAIL_SERVICE_ACCOUNT={"type":"service_account",...entire JSON...}
# GMAIL_CLIENT_EMAIL=hydrogrid-email@hydrogrid-xxxx.iam.gserviceaccount.com
# GMAIL_CLIENT_ID=123456789...
# SENDER_EMAIL=anantyashh21@gmail.com

# Option 2: Using Gmail SMTP (Local dev only - blocked on Render)
# 1. Enable 2-Factor Authentication in your Google Account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create an "App Password" for "Mail" and "Windows Computer"
# 4. Use that 16-character password (without spaces) as SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-16-chars
SMTP_SECURE=false
SENDER_EMAIL=your-email@gmail.com

# Option 3: Using Mailtrap (free testing service)
# Get credentials from https://mailtrap.io
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=your_mailtrap_username
# SMTP_PASS=your_mailtrap_password
# SMTP_SECURE=false

# Option 4: Using SendGrid
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key
# SMTP_SECURE=false

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Groq AI Key (for AI-powered insights)
GROQ_API_KEY=your-groq-api-key-here
