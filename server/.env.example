# MongoDB Connection String
# Use MongoDB Atlas (free tier) or local MongoDB
MONGODB_URI=mongodb://localhost:27017/hydrogrid

# JWT Secret Key - change this to a random string in production
JWT_SECRET=hydrogrid_super_secret_key_change_in_production

# Server Port
PORT=5000

# SMTP settings for email delivery
# Configure these with your real SMTP provider to deliver emails to users
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_username
SMTP_PASS=your_mailtrap_password
SMTP_SECURE=false

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
